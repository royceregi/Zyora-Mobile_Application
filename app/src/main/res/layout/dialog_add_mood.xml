<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Mood Selection Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Select your mood:"
            android:textColor="@color/text_primary_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="5"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVeryHappy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😄 Very Happy"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_happy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHappy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😊 Happy"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_happy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNeutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😐 Neutral"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_neutral" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😢 Sad"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_sad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerySad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😭 Very Sad"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_sad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAngry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😠 Angry"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/error_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnxious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😰 Anxious"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_anxious" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExcited"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🤩 Excited"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/mood_excited" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😌 Calm"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/accent_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTired"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="😴 Tired"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/text_secondary_light" />

        </GridLayout>

        <!-- Note Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Add a note (optional)"
            app:boxBackgroundColor="@color/card_background_light"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary_blue"
            app:hintTextColor="@color/text_hint_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
