<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Container Type Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Select container type:"
            android:textColor="@color/text_primary_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Glass (250ml)"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/accent_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBottle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Bottle (500ml)"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/primary_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Cup (200ml)"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/accent_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLargeBottle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Large Bottle (750ml)"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/primary_blue_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom Amount"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/text_secondary_light" />

        </LinearLayout>

        <!-- Amount Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount (ml)"
            app:boxBackgroundColor="@color/card_background_light"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/text_hint_light"
            app:startIconDrawable="@drawable/ic_water_drop"
            app:startIconTint="@color/accent_teal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/text_primary_light"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
